{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal site content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "maintenance",
    "site",
    "profile",
    "about",
    "publications",
    "projects",
    "misc",
    "blog"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "maintenance": {
      "type": "boolean"
    },
    "maintenance_image": {
      "type": "string",
      "description": "Optional site-relative image for the maintenance page."
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "language": { "type": "string", "default": "en", "description": "Homepage language tag." },
        "themes": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "items": { "enum": ["yuru", "werk", "pixel"] },
          "description": "Enabled themes in switch order. The first is the default. An empty list uses Yuru."
        },
        "favicon": { "type": "string", "description": "Site-relative or absolute HTTP(S) icon URL. Leave empty to omit the favicon." },
        "source_url": { "type": "string", "description": "Optional GitHub repository URL for the footer." },
        "seo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string", "description": "Page title. Defaults to the site name." },
            "description": { "type": "string" },
            "url": { "type": "string", "description": "Absolute homepage URL, including the repository path for project sites." },
            "image": { "type": "string", "description": "Social preview image URL or site-relative path. Relative paths require a homepage URL." },
            "robots": { "type": "string" },
            "alternate_names": { "type": "array", "items": { "type": "string" } },
            "same_as": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["photo", "name", "role", "school", "links"],
      "properties": {
        "badge": {
          "description": "Optional header badge. Its module defines its shape.",
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["list"],
              "properties": {
                "list": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 },
                  "description": "Site-relative badge modules available when the page loads. Each exports mount(canvas)."
                },
                "default": { "type": "string", "minLength": 1, "description": "Initial module from the list. Defaults to the first entry." },
                "mode": {
                  "enum": ["default", "random"],
                  "default": "default",
                  "description": "Use the default badge or choose a random badge from the list on each page load."
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 88,
                  "description": "Optional badge width in CSS pixels."
                }
              }
            }
          ]
        },
        "photo": { "type": "string", "description": "Site-relative path to the profile photo (e.g. data/images/profile/me.jpg)." },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "school": { "type": "string" },
        "links": {
          "type": "array",
          "items": { "$ref": "#/$defs/link" }
        }
      }
    },
    "about": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "content"],
      "properties": {
        "title": { "type": "string" },
        "description": { "$ref": "#/$defs/sectionDescription" },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["experience", "education"],
          "properties": {
            "experience": { "$ref": "#/$defs/experienceSection" },
            "education": { "$ref": "#/$defs/educationSection" }
          }
        }
      }
    },
    "publications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "content"],
      "properties": {
        "title": { "type": "string" },
        "description": { "$ref": "#/$defs/sectionDescription" },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/publication" }
        }
      }
    },
    "projects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "content"],
      "properties": {
        "title": { "type": "string" },
        "description": { "$ref": "#/$defs/sectionDescription" },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/project" }
        },
        "items_per_page": {
          "type": "integer",
          "minimum": 1,
          "default": 5,
          "description": "Number of projects shown on each project list page."
        }
      }
    },
    "misc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "content"],
      "properties": {
        "title": { "type": "string" },
        "description": { "$ref": "#/$defs/sectionDescription" },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/miscItem" }
        }
      }
    },
    "blog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "content"],
      "properties": {
        "title": { "type": "string" },
        "description": { "$ref": "#/$defs/sectionDescription" },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/blogPost" }
        },
        "posts_per_page": {
          "type": "integer",
          "minimum": 1,
          "default": 5,
          "description": "Number of posts shown on each blog list page."
        }
      }
    }
  },
  "$defs": {
    "sectionDescription": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "type": "string" }
        }
      ]
    },
    "experienceSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "items"],
      "properties": {
        "title": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/experience" }
        }
      }
    },
    "educationSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "items"],
      "properties": {
        "title": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/education" }
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string" },
        "url": { "type": "string" },
        "icon": { "type": "string", "description": "Optional icon key rendered from assets/icons/<key>.svg (built-in keys: mail, github, orcid)." }
      }
    },
    "education": {
      "type": "object",
      "additionalProperties": false,
      "required": ["degree", "school", "date", "details", "logo"],
      "properties": {
        "degree": { "type": "string" },
        "school": { "type": "string" },
        "date": { "type": "string" },
        "details": { "type": "string" },
        "logo": { "type": "string", "description": "Site-relative path to the school logo image (e.g. data/images/logos/nus_logo.png)." }
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "org", "date", "meta", "description"],
      "properties": {
        "role": { "type": "string" },
        "org": { "type": "string" },
        "date": { "type": "string" },
        "meta": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "authors", "conference", "teaser", "abstract", "links"],
      "properties": {
        "title": { "type": "string" },
        "authors": { "type": "string" },
        "conference": { "type": "string" },
        "teaser": { "type": "string", "description": "Site-relative path to a teaser image or a video that loops silently." },
        "background_image": { "type": "string", "description": "Optional site-relative path or full URL to a decorative publication background image." },
        "poster": { "type": "string", "description": "Site-relative path to the publication poster image (optional)." },
        "abstract": { "type": "string" },
        "links": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "date", "description", "run_url"],
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "run_url": { "type": "string", "description": "Site-relative path or full URL to a runnable demo page." },
        "background_image": { "type": "string", "description": "Optional site-relative path or full URL to a decorative background image for the wide project list layout." }
      }
    },
    "miscItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "module"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "module": {
          "oneOf": [
            { "$ref": "#/$defs/galleryModule" },
            { "$ref": "#/$defs/youtubeModule" },
            { "$ref": "#/$defs/mapModule" }
          ]
        }
      }
    },
    "galleryModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "const": "gallery" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["src", "alt"],
            "properties": {
              "src": { "type": "string", "description": "Site-relative path to the gallery image." },
              "thumbnail": { "type": "string", "description": "Optional lightweight image for the gallery grid. The full-size image opens from src." },
              "alt": { "type": "string" }
            }
          }
        }
      }
    },
    "youtubeModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": { "const": "youtube" },
        "url": { "type": "string" }
      }
    },
    "mapModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "places"],
      "properties": {
        "type": { "const": "map" },
        "places": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "lat", "lon"],
            "properties": {
              "name": { "type": "string" },
              "lat": { "type": "number", "minimum": -90, "maximum": 90 },
              "lon": { "type": "number", "minimum": -180, "maximum": 180 }
            }
          }
        }
      }
    },
    "blogPost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "cover", "intro"],
      "oneOf": [{ "required": ["markdown"] }, { "required": ["html"] }],
      "properties": {
        "title": { "type": "string" },
        "cover": { "type": "string", "description": "Site-relative path to the post cover image (e.g. posts/my-post/cover.jpg)." },
        "cover_credit": { "type": "string", "description": "Optional visible image credit. Supports a link to the source." },
        "intro": { "type": "string" },
        "markdown": { "type": "string", "minLength": 1, "description": "Site-relative path to the post Markdown file." },
        "html": { "type": "string", "minLength": 1, "description": "Site-relative path to a trusted HTML fragment containing the post body." }
      }
    }
  }
}
